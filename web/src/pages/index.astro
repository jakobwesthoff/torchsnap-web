---
import Layout from "../site/Layout.astro";
import Hero from "../landing/Hero.astro";
import HotkeyBanner from "../landing/HotkeyBanner.astro";
import MascotTheater from "../landing/mascot-theater/MascotTheater.astro";
import FeatureRow from "../landing/FeatureRow.astro";
import PluginUniverse from "../landing/plugin-universe/PluginUniverse.astro";
---

<Layout>
  {/* Hero + HotkeyBanner together fill at least the first viewport
      "page" (minus the sticky header). Hero takes any extra space via
      `flex-1`, vertically centring its content; HotkeyBanner keeps
      its natural size and sits flush against the fold so the user
      always sees it as the bottom of the initial screen, with the
      next section discoverable on scroll. */}
  <div class="flex min-h-[calc(100svh-3.5rem)] flex-col">
    <Hero />
    <HotkeyBanner />
  </div>
  <MascotTheater />
  <PluginUniverse />
  <FeatureRow />
</Layout>
