---
import Layout from "../site/Layout.astro";
import Hero from "../landing/hero/Hero.astro";
import HotkeyTagline from "../landing/HotkeyTagline.astro";
import MascotTheater from "../landing/mascot-theater/MascotTheater.astro";
import Convictions from "../landing/Convictions.astro";
import Gadgets from "../landing/gadgets/Gadgets.astro";
---

<Layout>
  {/* Hero + HotkeyTagline together fill at least the first viewport
      "page" (minus the sticky header). Hero takes any extra space via
      `flex-1`, vertically centring its content; HotkeyTagline keeps
      its natural size and sits flush against the fold so the user
      always sees it as the bottom of the initial screen, with the
      next section discoverable on scroll. */}
  <div class="flex min-h-[calc(100svh-3.5rem)] flex-col">
    <Hero />
    <HotkeyTagline />
  </div>
  <MascotTheater />
  <Gadgets />
  <Convictions />
</Layout>
