---
// Generic, content-agnostic horizontal carousel:
//   - native CSS scroll-snap as the base (works without JS — swipe,
//     momentum, snap all "free")
//   - autoCarousel.client.ts enhances it with auto-advance that pauses
//     on interaction, when offscreen, when the tab is hidden
//   - `prefers-reduced-motion` opts out of auto-advance entirely;
//     the strip remains swipeable
//
// The component owns the strip element and its scoped behavior;
// callers pass arbitrary children as direct slot content. Each direct
// child becomes one snap target, sized via the `slideWidth` /
// `maxSlideWidth` props. No assumption about what the slides contain.
//
// Multiple instances per page are supported: the script self-tags
// each strip with `data-auto-carousel-init` and skips already-wired
// elements.

interface Props {
  // Accessible label for the strip (`<ol aria-label>`).
  ariaLabel: string;
  // Auto-advance period. Set to 0 to disable autoplay even with
  // motion enabled.
  intervalMs?: number;
  // After any user interaction (touch, pointer, wheel, manual
  // scroll), wait at least this long before the timer is allowed to
  // fire again.
  pauseAfterInteractionMs?: number;
  // Width of each slide. Any CSS length / calc() expression.
  // Default leaves a small peek of the next slide on a phone.
  slideWidth?: string;
  // Optional cap so slides never grow past a comfortable card width
  // on larger viewports the carousel is still visible at.
  maxSlideWidth?: string;
  // Gap between slides.
  gap?: string;
  // Minimum inline padding on the leading and trailing edges. The
  // strip auto-pads enough to center the first and last slides
  // (so `scroll-snap-align: center` actually centers them); this
  // value is the lower bound when the slide is already nearly as wide
  // as the strip.
  minEdgePadding?: string;
  // Extra classes for the outer wrapper (e.g. responsive visibility).
  class?: string;
}

const {
  ariaLabel,
  intervalMs = 4000,
  pauseAfterInteractionMs = 6000,
  slideWidth = "calc(100vw - 4rem)",
  maxSlideWidth = "320px",
  gap = "1rem",
  minEdgePadding = "1rem",
  class: outerClass,
} = Astro.props;
---

<div class:list={[outerClass]}>
  <ol
    data-auto-carousel
    data-interval={intervalMs}
    data-pause-ms={pauseAfterInteractionMs}
    aria-label={ariaLabel}
    class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    style={`--slide-w: ${slideWidth}; --slide-max-w: ${maxSlideWidth}; --min-edge: ${minEdgePadding}; column-gap: ${gap};`}
  >
    <slot />
  </ol>
</div>

<style is:global>
  /* Direct children of the strip are the snap targets. Scoped by the
     `[data-auto-carousel]` attribute selector so this rule cannot leak
     to unrelated lists. */
  [data-auto-carousel] > * {
    flex-shrink: 0;
    scroll-snap-align: center;
    width: var(--slide-w);
    max-width: var(--slide-max-w);
  }

  /* Symmetric inline padding sized so the first and last slides
     actually centre under `scroll-snap-align: center`. The padding
     equals half the leftover space between the strip and one slide,
     clamped to a minimum so a near-full-width slide still gets a
     comfortable peek of the edge. */
  [data-auto-carousel] {
    padding-inline: max(
      var(--min-edge),
      calc((100% - min(var(--slide-w), var(--slide-max-w))) / 2)
    );
  }
</style>

<script>
  import { initAutoCarousels } from "./autoCarousel.client";
  initAutoCarousels();
</script>
