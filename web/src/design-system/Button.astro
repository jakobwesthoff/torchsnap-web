---
import { Icon } from "astro-icon/components";

interface Props {
  variant?: "primary" | "ghost";
  href: string;
  /** astro-icon name, e.g. "heroicons:arrow-down-tray" or "simple-icons:github" */
  icon?: string;
  external?: boolean;
}

const { variant = "primary", href, icon, external = false } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium transition-colors";
const variantClass =
  variant === "primary"
    ? "bg-accent text-white hover:bg-accent-hover"
    : "border border-border text-text-primary hover:bg-surface-hover hover:border-border-hover";
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={[base, variantClass]}
>
  {icon && <Icon name={icon} class="h-4 w-4" />}
  <slot />
</a>
