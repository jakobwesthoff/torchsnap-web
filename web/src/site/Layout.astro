---
import "../design-system/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Torchsnap", description = "Keyboard-first launcher for the apps, files, and small tasks you reach for all day." } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Pre-paint theme init: read the persisted preference and apply
      // the resolved theme before first paint to avoid a flash. The
      // value mirrors the API in src/theme/preference.ts:
      //   "light" / "dark"  → forced
      //   missing / "system" → follow prefers-color-scheme
      (() => {
        const stored = localStorage.getItem("theme");
        const preference =
          stored === "light" || stored === "dark" ? stored : "system";
        const resolved =
          preference === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : preference;
        if (resolved === "dark") document.documentElement.dataset.theme = "dark";
      })();
    </script>
  </head>
  <body class="flex min-h-svh flex-col bg-surface text-text-primary font-sans antialiased">
    <Header />
    <main class="mx-auto w-full max-w-[1280px] flex-1"><slot /></main>
    <Footer />
  </body>
</html>
