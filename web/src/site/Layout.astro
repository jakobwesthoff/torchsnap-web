---
import "../design-system/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title?: string;
  description?: string;
  // Document language. Defaults to English; legal pages with German
  // content (e.g. /impressum) override to "de" so screen readers and
  // automated translators apply the correct language model.
  lang?: string;
  // Block search-engine indexing. Defaults to false. The Impressum
  // page sets this to true since the German legal-text content is
  // not search-relevant for the product.
  noindex?: boolean;
}

const {
  title = "Torchsnap",
  description = "Keyboard-first launcher for the apps, files, and small tasks you reach for all day.",
  lang = "en",
  noindex = false,
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon-128.png" />
    <script is:inline>
      // Pre-paint theme init: read the persisted preference and apply
      // the resolved theme before first paint to avoid a flash. The
      // value mirrors the API in src/theme/preference.ts:
      //   "light" / "dark"  → forced
      //   missing / "system" → follow prefers-color-scheme
      (() => {
        const stored = localStorage.getItem("theme");
        const preference =
          stored === "light" || stored === "dark" ? stored : "system";
        const resolved =
          preference === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : preference;
        if (resolved === "dark") document.documentElement.dataset.theme = "dark";
      })();
    </script>
  </head>
  <body class="flex min-h-svh flex-col bg-surface text-text-primary font-sans antialiased">
    <Header />
    {/* Sections inside main own their own backgrounds (full-bleed)
        and constrain their content + border with an inner
        mx-auto max-w-[1280px] wrapper. Same pattern Header / Footer
        already use. */}
    <main class="flex w-full flex-1 flex-col"><slot /></main>
    <Footer />
  </body>
</html>
