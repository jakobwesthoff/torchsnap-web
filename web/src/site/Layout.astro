---
import "../design-system/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title?: string;
  description?: string;
  // Document language. Defaults to English; legal pages with German
  // content (e.g. /impressum) override to "de" so screen readers and
  // automated translators apply the correct language model.
  lang?: string;
  // Block search-engine indexing. Defaults to false. The Impressum
  // page sets this to true since the German legal-text content is
  // not search-relevant for the product.
  noindex?: boolean;
}

// Defaults mirror the hero copy verbatim so social previews promise
// what the visitor actually lands on. They're shorter / longer than
// the 50-60 / 110-160 SEO heuristics respectively, but trading strict
// conformance for single-source authenticity is the right call here:
// the alternative is inventing parallel marketing copy that drifts
// out of sync with the live page.
const {
  title = "Torchsnap — Strike a key, light the way.",
  description = "Torchsnap is a keyboard-first launcher for the apps, files, and small tasks you reach for all day. A tiny window, a single hotkey, and a Gadget ecosystem to make it your own.",
  lang = "en",
  noindex = false,
} = Astro.props;

// Absolute URLs for social-share meta tags. `Astro.url.origin` is
// the actual host the page is being served from:
//   - in `astro build` it resolves to the configured `site` origin
//     (https://torchsnap.app), giving correct production canonicals
//   - in `astro dev` it resolves to the request origin
//     (http://localhost:4321 or a *.trycloudflare.com tunnel),
//     making OG previews work without redeploying
// Picking origin over the static `Astro.site` setting is what makes
// share-card validation possible while developing locally.
const origin = Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).toString();
const ogImage = new URL("/og.png", origin).toString();
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />

    {/* Open Graph + Twitter — branded preview when shared. The
        single static og.png ships from web/public/ and is generated
        by tools/build-og.ts. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Torchsnap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Torchsnap — Light · Find · Launch" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Torchsnap — Light · Find · Launch" />
    <script is:inline>
      // Pre-paint theme init: read the persisted preference and apply
      // the resolved theme before first paint to avoid a flash. The
      // value mirrors the API in src/theme/preference.ts:
      //   "light" / "dark"  → forced
      //   missing / "system" → follow prefers-color-scheme
      //
      // We also stamp the preference itself onto <html> so the theme
      // toggle in the footer can render the active pill at the right
      // offset on first paint without a client-side reflow.
      (() => {
        const stored = localStorage.getItem("theme");
        const preference =
          stored === "light" || stored === "dark" ? stored : "system";
        const resolved =
          preference === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : preference;
        if (resolved === "dark") document.documentElement.dataset.theme = "dark";
        document.documentElement.dataset.themePreference = preference;
      })();
    </script>
  </head>
  <body class="flex min-h-svh flex-col bg-surface text-text-primary font-sans antialiased">
    <Header />
    {/* Sections inside main own their own backgrounds (full-bleed)
        and constrain their content + border with an inner
        mx-auto max-w-[1280px] wrapper. Same pattern Header / Footer
        already use. */}
    <main class="flex w-full flex-1 flex-col"><slot /></main>
    <Footer />
  </body>
</html>
