---
import "../design-system/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title?: string;
  description?: string;
  // Document language. Defaults to English; legal pages with German
  // content (e.g. /impressum) override to "de" so screen readers and
  // automated translators apply the correct language model.
  lang?: string;
  // Block search-engine indexing. Defaults to false. The Impressum
  // page sets this to true since the German legal-text content is
  // not search-relevant for the product.
  noindex?: boolean;
}

const {
  title = "Torchsnap",
  description = "Keyboard-first launcher for the apps, files, and small tasks you reach for all day.",
  lang = "en",
  noindex = false,
} = Astro.props;

// Absolute URLs for social-share meta tags. `Astro.site` comes from
// the `site` setting in astro.config.mjs; both fall back to a
// relative path when running with no site configured (e.g. early dev).
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;
const ogImage = Astro.site
  ? new URL("/og.png", Astro.site).toString()
  : "/og.png";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon-128.png" />

    {/* Open Graph + Twitter — branded preview when shared. The
        single static og.png ships from web/public/ and is generated
        by tools/build-og.ts. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Torchsnap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Torchsnap — Light · Find · Launch" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Torchsnap — Light · Find · Launch" />
    <script is:inline>
      // Pre-paint theme init: read the persisted preference and apply
      // the resolved theme before first paint to avoid a flash. The
      // value mirrors the API in src/theme/preference.ts:
      //   "light" / "dark"  → forced
      //   missing / "system" → follow prefers-color-scheme
      (() => {
        const stored = localStorage.getItem("theme");
        const preference =
          stored === "light" || stored === "dark" ? stored : "system";
        const resolved =
          preference === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : preference;
        if (resolved === "dark") document.documentElement.dataset.theme = "dark";
      })();
    </script>
  </head>
  <body class="flex min-h-svh flex-col bg-surface text-text-primary font-sans antialiased">
    <Header />
    {/* Sections inside main own their own backgrounds (full-bleed)
        and constrain their content + border with an inner
        mx-auto max-w-[1280px] wrapper. Same pattern Header / Footer
        already use. */}
    <main class="flex w-full flex-1 flex-col"><slot /></main>
    <Footer />
  </body>
</html>
