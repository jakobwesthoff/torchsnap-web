---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import snappyOriginal from "../assets/mascots/snappy-original-1024.png";

// Ordered by where the linked section sits on the page (top → bottom).
// Hrefs include the explicit `/` prefix so the link works from any
// route (e.g. /impressum) and not just from the homepage — bare
// fragments would otherwise just append `#section` to whatever the
// current path is.
const NAV_LINKS = [
  { href: "/#download", label: "Download" },
  { href: "/#cast", label: "Wardrobe" },
  { href: "/#gadgets", label: "Gadgets" },
  { href: "/#developers", label: "For developers" },
  { href: "/#features", label: "Convictions" },
];
const GITHUB_URL = "https://github.com/jakobwesthoff/torchsnap";
---

<header
  class:list={[
    "group sticky top-0 z-40",
    // Visual state changes when the page is scrolled past the top.
    // The data-scrolled attribute is flipped by the script below.
    "transition-[background-color,backdrop-filter,box-shadow,border-color] duration-200 ease-out",
    "border-b border-transparent bg-transparent",
    "data-scrolled:border-border-divider data-scrolled:bg-surface/80 data-scrolled:backdrop-blur-md data-scrolled:shadow-[0_1px_2px_rgb(0_0_0/0.04)]",
  ]}
  data-site-header
>
  {/* Inner row keeps a constant height across scroll states. The
      sticky element used to collapse from py-5 to py-3 once scrolled
      past the threshold, but a sticky element changing its own size
      while the user scrolls is exactly what Firefox flags as a
      "scroll-linked positioning effect" (jittery on async scroll,
      thrashes scroll-anchoring). Visual feedback that the page has
      scrolled now lives entirely in the outer header's bg / blur /
      border / shadow change. */}
  <div class="section-inner flex items-center justify-between gap-4 py-3">
    <a href="/" class="inline-flex items-center gap-2">
      <Image
        src={snappyOriginal}
        alt=""
        width={32}
        height={32}
        densities={[1, 2, 3]}
        format="webp"
        loading="eager"
        class="block h-8 w-8 object-contain"
      />
      <span class="text-base font-semibold tracking-tight text-text-primary">Torchsnap</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="text-[13px] font-medium text-text-secondary hover:text-text-primary transition-colors"
        >
          {link.label}
        </a>
      ))}
      {/* StarNudge measures this element to aim its arrow. The nudge
          draws nothing when the box is zero-sized, which is what
          happens below `md` where this nav is hidden. */}
      <a
        href={GITHUB_URL}
        aria-label="GitHub"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-secondary hover:text-text-primary transition-colors"
        data-star-nudge-anchor
      >
        <Icon name="simple-icons:github" class="h-5 w-5" />
      </a>
    </nav>

    <button
      type="button"
      class="group inline-flex h-9 w-9 items-center justify-center rounded-md text-text-secondary hover:bg-surface-hover md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-mobile-nav-toggle
    >
      {/* Hamburger when collapsed, X when expanded. CSS-only swap
          via aria-expanded on the wrapping `group`. */}
      <Icon name="heroicons:bars-3" class="h-5 w-5 group-aria-expanded:hidden" />
      <Icon name="heroicons:x-mark" class="hidden h-5 w-5 group-aria-expanded:block" />
    </button>
  </div>
</header>

{/* Mobile nav panel — rendered as a SIBLING of <header>, not a
    child. Once the scrolled header gets `backdrop-filter:
    blur(...)`, it becomes a "backdrop root": any descendant's
    own backdrop-filter samples from the parent's already-
    rendered output instead of the actual page content,
    silently losing its glass effect. Lifting the panel out of
    the header DOM keeps its backdrop-filter independent so the
    blur survives in every header state.

    `fixed` at `top-14` (the header's 56 px height) so the
    panel sits flush below the header and stays in place while
    the page scrolls underneath. */}
<nav
  id="mobile-nav"
  class="fixed inset-x-0 top-14 z-30 hidden border-b border-border-divider bg-surface/80 backdrop-blur-md shadow-[0_2px_4px_rgb(0_0_0/0.05)] md:hidden"
  aria-label="Primary mobile"
>
  <ul class="section-inner flex flex-col gap-1 py-3">
    {NAV_LINKS.map((link) => (
      <li>
        <a
          href={link.href}
          class="block rounded-md px-3 py-2 text-sm font-medium text-text-secondary hover:bg-surface-hover hover:text-text-primary"
        >
          {link.label}
        </a>
      </li>
    ))}
    <li>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="block rounded-md px-3 py-2 text-sm font-medium text-text-secondary hover:bg-surface-hover hover:text-text-primary"
      >
        GitHub
      </a>
    </li>
  </ul>
</nav>

<script>
  import { initHeader } from "./header.client";
  initHeader();
</script>
