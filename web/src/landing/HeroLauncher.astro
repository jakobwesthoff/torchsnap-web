---
import { Image } from "astro:assets";
import snappyOriginal from "../assets/mascots/snappy-original-1024.png";
import { DemoLauncher } from "../launcher/DemoLauncher";
---

<div class="relative mx-auto mt-[150px] w-full max-w-[520px]">
  {/* Snappy perched on top of the search bar — only the paws dip
      into the card. The mascot stays in the Astro tree so it can use
      the build-time webp + density pipeline; the React island below
      owns the launcher card itself. */}
  <Image
    src={snappyOriginal}
    alt=""
    width={170}
    height={170}
    densities={[1, 2, 3]}
    format="webp"
    loading="eager"
    fetchpriority="high"
    class="pointer-events-none absolute -top-[138px] left-1/2 z-10 h-[170px] w-[170px] -translate-x-1/2 select-none object-contain"
  />

  <DemoLauncher client:visible />
</div>
