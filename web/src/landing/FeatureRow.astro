---
// FeatureManifesto layout from V1bFull.jsx in the design bundle.
// Three large slab cards stacked vertically; each has a rotated
// vertical numeral+kicker strip on the left, a punchy statement
// in the middle, and a small visual anchor on the right.

interface Item {
  n: string;
  kicker: string;
  title: string;
  body: string;
  visual: "speed" | "trust" | "yours";
}

const ITEMS: Item[] = [
  {
    n: "01",
    kicker: "Speed",
    title: "From thought to result in 80 milliseconds.",
    body:
      "One global hotkey. The window appears already focused, ranking results before your finger leaves the key. Esc and it's gone — no menu bar, no dock, no afterimage.",
    visual: "speed",
  },
  {
    n: "02",
    kicker: "Trust",
    title: "Nothing leaves your machine until you say so.",
    body:
      "Every plugin is a sandboxed WebAssembly bundle with a written-down capability list. Clipboard, filesystem, network — each one is opt-in, revocable, and visible at a glance.",
    visual: "trust",
  },
  {
    n: "03",
    kicker: "Yours",
    title: "Theme it, extend it, ship your own plugin tonight.",
    body:
      "Any language that compiles to wasm32-wasip2. A typed SDK. A directory that's a folder of files, not a marketplace. Bring your own keys, bindings, themes, and tools.",
    visual: "yours",
  },
];

const CAPABILITIES = [
  { name: "clipboard", on: true },
  { name: "fs.read", on: true },
  { name: "fs.write", on: false },
  { name: "network", on: false },
];

const LANGUAGES = [
  { name: "Rust", v: "rustc 1.78" },
  { name: "TypeScript", v: "node 22" },
  { name: "Go", v: "go 1.23" },
  { name: "Zig", v: "zig 0.13" },
];
---

<section
  id="features"
  class="border-t border-border-divider bg-surface-inset px-6 pt-14 pb-24 lg:px-16 lg:pb-32"
>
  {/* Section head */}
  <div class="mb-12 max-w-[680px] lg:mb-16">
    <p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-accent">
      What's in the box
    </p>
    <h2 class="text-balance text-3xl font-semibold leading-[1.1] tracking-tight md:text-4xl">
      Three things. Done with conviction.
    </h2>
    <p class="mt-4 max-w-[600px] text-pretty text-base leading-relaxed text-text-secondary">
      No feature checklist. No matrix. Just three opinions about what a
      launcher should be, and a refusal to be anything else.
    </p>
  </div>

  {/* Three slab cards */}
  <div class="flex flex-col gap-6 lg:gap-8">
    {ITEMS.map((m) => (
      <article
        class="grid gap-6 rounded-[20px] border border-border bg-surface p-6 shadow-[0_2px_8px_rgb(0_0_0/0.06),0_1px_2px_rgb(0_0_0/0.04)] md:grid-cols-[auto_1fr_auto] md:items-center md:gap-10 md:p-10 lg:gap-12 lg:p-12"
      >
        {/* Vertical numeral + kicker strip (horizontal eyebrow on mobile) */}
        <div
          class="flex items-center justify-start gap-3 self-stretch font-mono text-xs font-semibold uppercase tracking-[0.2em] text-accent
                 md:justify-center md:gap-3.5 md:[transform:rotate(180deg)] md:[writing-mode:vertical-rl]"
        >
          <span>{m.n}</span>
          <span class="text-text-muted">{m.kicker}</span>
        </div>

        {/* Statement */}
        <div class="min-w-0">
          <h3 class="text-balance text-2xl font-semibold leading-[1.15] tracking-tight md:text-[32px] lg:text-[40px]">
            {m.title}
          </h3>
          <p class="mt-3 max-w-[620px] text-pretty text-base leading-relaxed text-text-secondary md:mt-4">
            {m.body}
          </p>
        </div>

        {/* Visual anchor — centered below on mobile, side-by-side from md */}
        <div class="justify-self-center md:justify-self-auto">
          {m.visual === "speed" && (
            <div class="flex items-center gap-2 px-2 -rotate-[4deg]">
              <kbd
                class="inline-flex h-12 min-w-[44px] items-center justify-center rounded-lg border border-border bg-surface-inset px-3 font-mono text-lg font-medium text-text-primary shadow-[inset_0_-2px_0_var(--color-border)]"
              >
                ⌘
              </kbd>
              <kbd
                class="inline-flex h-12 min-w-[44px] items-center justify-center rounded-lg border border-border bg-surface-inset px-4 font-mono text-base font-medium text-text-primary shadow-[inset_0_-2px_0_var(--color-border)]"
              >
                Space
              </kbd>
            </div>
          )}

          {m.visual === "trust" && (
            <div
              class="min-w-[220px] rounded-xl border border-border bg-surface-inset p-3.5 font-mono text-[11px] text-text-secondary"
            >
              <div
                class="mb-2 text-[10px] font-bold uppercase tracking-[0.14em] text-text-muted"
              >
                capabilities
              </div>
              {CAPABILITIES.map((c) => (
                <div class="flex items-center gap-2 py-0.5">
                  <span
                    class:list={[
                      "h-2 w-2 rounded-full",
                      c.on ? "bg-accent" : "bg-border",
                    ]}
                  ></span>
                  <span class={c.on ? "text-text-primary" : "text-text-muted"}>
                    {c.name}
                  </span>
                  <span
                    class:list={[
                      "ml-auto text-[9px]",
                      c.on ? "text-accent" : "text-text-muted",
                    ]}
                  >
                    {c.on ? "ALLOW" : "DENY"}
                  </span>
                </div>
              ))}
            </div>
          )}

          {m.visual === "yours" && (
            <div
              class="flex min-w-[200px] flex-col gap-1.5 rounded-xl border border-border bg-surface-inset px-3.5 py-3 font-mono text-[11px]"
            >
              <div
                class="mb-1 text-[10px] font-bold uppercase tracking-[0.14em] text-text-muted"
              >
                build with
              </div>
              {LANGUAGES.map((l) => (
                <div class="flex justify-between gap-3 text-text-primary">
                  <span>{l.name}</span>
                  <span class="text-text-muted">{l.v}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
