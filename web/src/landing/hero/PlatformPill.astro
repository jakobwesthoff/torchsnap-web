---
import { Icon } from "astro-icon/components";

type OS = "mac" | "win" | "linux";

interface Props {
  os: OS;
  available?: boolean;
  // Qualifier shown after the label of an available platform, such as the
  // hardware the download runs on.
  note?: string;
}

const { os, available = false, note } = Astro.props;

const META: Record<OS, { icon: string; label: string }> = {
  mac: { icon: "simple-icons:apple", label: "macOS" },
  win: { icon: "simple-icons:windows", label: "Windows" },
  linux: { icon: "simple-icons:linux", label: "Linux" },
};

const { icon, label } = META[os];
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium",
    available
      ? "border-border bg-surface text-text-secondary"
      : "border-border-divider bg-surface-inset text-text-muted",
  ]}
>
  <Icon name={icon} class="h-3.5 w-3.5" />
  <span>{label}</span>
  {available && note && <span class="text-text-muted">· {note}</span>}
  {!available && <span class="text-text-muted/80">· Coming soon</span>}
</span>
