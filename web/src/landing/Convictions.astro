---
// Three large slab cards stacked vertically; each has a rotated
// vertical numeral+kicker strip on the left, a punchy statement
// in the middle, and a small visual anchor on the right.

import { Icon } from "astro-icon/components";

interface Item {
  n: string;
  kicker: string;
  title: string;
  body: string;
  visual: "speed" | "everywhere" | "open";
}

const GITHUB_URL = "https://github.com/jakobwesthoff/torchsnap";

const ITEMS: Item[] = [
  {
    n: "01",
    kicker: "Speed",
    title: "From thought to result. No detour.",
    body:
      "One global hotkey. The window appears already focused, ranking results before your finger leaves the key. Esc and it's gone. No menu bar, no dock, no afterimage.",
    visual: "speed",
  },
  {
    n: "02",
    kicker: "Everywhere",
    title: "One launcher. Three operating systems. Same muscle memory.",
    body:
      "Cross-platform from day one. Same hotkey, same fuzzy ranker, same Gadget format on every desk. macOS today; Linux next, Windows to follow.",
    visual: "everywhere",
  },
  {
    n: "03",
    kicker: "Open",
    title: "No account. No telemetry. No catch.",
    body:
      "Nothing leaves your machine. Nothing to sign up for. The source is on GitHub if you want to verify any of that yourself.",
    visual: "open",
  },
];

// Visual anchor for the "Everywhere" card: three OS icons in a row.
// macOS is rendered as shipping; Linux as next-up; Windows as later.
// Each gets a different status word so the visual mirrors the roadmap
// in the body copy without needing a legend.
const PLATFORMS = [
  { icon: "simple-icons:apple",   label: "macOS",   status: "shipping" as const },
  { icon: "simple-icons:linux",   label: "Linux",   status: "next"     as const },
  { icon: "simple-icons:windows", label: "Windows", status: "later"    as const },
];

// Visual anchor for the "Open" card: a compact checklist that mirrors
// the body's proof points so a skim-reader can read either side and
// land on the same claims.
const OPEN_PROOFS = [
  { label: "no account",      on: true },
  { label: "no telemetry",    on: true },
  { label: "open source",     on: true },
  { label: "MPL-2.0",         on: true },
];
---

<section id="features" class="border-t border-border-divider bg-surface-inset">
  <div class="section-inner pt-14 pb-24 lg:pb-32">
  {/* Section head */}
  <div class="mb-12 text-center lg:mb-16">
    <p class="eyebrow mb-3">
      Lines in the sand
    </p>
    <h2 class="text-balance text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl lg:text-[56px]">
      Three things.
      <br />
      <span class="font-medium italic text-accent">Done with conviction.</span>
    </h2>
    <p class="mx-auto mt-4 max-w-[640px] text-pretty text-base leading-relaxed text-text-secondary">
      No feature checklist. No matrix. Just three opinions about what a
      launcher should be, and a refusal to be anything else.
    </p>
  </div>

  {/* Three slab cards */}
  <div class="flex flex-col gap-6 lg:gap-8">
    {ITEMS.map((m) => (
      <article
        class="grid gap-6 rounded-[20px] border border-border bg-surface p-6 shadow-[0_2px_8px_rgb(0_0_0/0.06),0_1px_2px_rgb(0_0_0/0.04)] md:grid-cols-[auto_1fr_auto] md:items-center md:gap-10 md:p-10 lg:gap-12 lg:p-12"
      >
        {/* Vertical numeral + kicker strip (horizontal eyebrow on mobile) */}
        <div
          class="flex items-center justify-start gap-3 self-stretch font-mono text-xs font-semibold uppercase tracking-[0.2em] text-accent
                 md:justify-center md:gap-3.5 md:[transform:rotate(180deg)] md:[writing-mode:vertical-rl]"
        >
          <span>{m.n}</span>
          <span class="text-text-muted">{m.kicker}</span>
        </div>

        {/* Statement */}
        <div class="min-w-0">
          <h3 class="text-balance text-2xl font-semibold leading-[1.15] tracking-tight md:text-[32px] lg:text-[40px]">
            {m.title}
          </h3>
          <p class="mt-3 max-w-[620px] text-pretty text-base leading-relaxed text-text-secondary md:mt-4">
            {m.body}
          </p>
        </div>

        {/* Visual anchor — centered below on mobile, side-by-side from md */}
        <div class="justify-self-center md:justify-self-auto">
          {m.visual === "speed" && (
            <div class="flex items-center gap-2 px-2 -rotate-[4deg]">
              <kbd
                class="keycap h-12 min-w-[44px] rounded-lg px-3 text-lg text-text-primary shadow-[inset_0_-2px_0_var(--color-border)]"
              >
                ⌘
              </kbd>
              <kbd
                class="keycap h-12 min-w-[44px] rounded-lg px-4 text-base text-text-primary shadow-[inset_0_-2px_0_var(--color-border)]"
              >
                Space
              </kbd>
            </div>
          )}

          {m.visual === "everywhere" && (
            <div
              class="flex min-w-[220px] items-end justify-center gap-6 rounded-xl border border-border bg-surface-inset px-5 py-4"
            >
              {PLATFORMS.map((p) => (
                <div class="flex flex-col items-center gap-1.5">
                  <Icon
                    name={p.icon}
                    class:list={[
                      "h-8 w-8",
                      p.status === "shipping" && "text-text-primary",
                      p.status === "next"     && "text-text-secondary opacity-80",
                      p.status === "later"    && "text-text-muted opacity-50",
                    ]}
                  />
                  <span
                    class:list={[
                      "font-mono text-[10px] font-bold uppercase tracking-[0.14em]",
                      p.status === "shipping" && "text-accent",
                      p.status === "next"     && "text-text-secondary",
                      p.status === "later"    && "text-text-muted",
                    ]}
                  >
                    {p.status === "shipping" ? p.label : p.status}
                  </span>
                </div>
              ))}
            </div>
          )}

          {m.visual === "open" && (
            <div
              class="flex min-w-[220px] flex-col gap-1.5 rounded-xl border border-border bg-surface-inset p-3.5 font-mono text-[11px] text-text-secondary"
            >
              <div
                class="mb-1 text-[10px] font-bold uppercase tracking-[0.14em] text-text-muted"
              >
                what we collect
              </div>
              {OPEN_PROOFS.map((p) => (
                <div class="flex items-center gap-2 py-0.5">
                  <Icon name="heroicons:check-circle" class="h-3.5 w-3.5 text-accent" />
                  <span class="text-text-primary">{p.label}</span>
                </div>
              ))}
              <a
                href={GITHUB_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.14em] text-accent hover:underline"
              >
                <Icon name="simple-icons:github" class="h-3 w-3" />
                verify on github
              </a>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
  </div>
</section>
