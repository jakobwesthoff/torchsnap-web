---
// "Meet the cast" — Variant A from CastVariations.jsx (tilted
// polaroids). Seven hand-pinned cards across two rows. The
// werewolf in the bottom-right gets a silhouette / mystery
// treatment so the bright cosplays read as a set with one
// deliberate outlier.
//
// Mascot lineup is mostly placeholder for now (4 × original)
// plus the three confirmed variants: dino, minion, werewolf.
// Names and roles are lifted/inspired by the design bundle
// (SNAPPY_CAST in V1bFull); body copy adapts the alt strings
// from torchsnap/src/derived/mascots.json.

import { Image } from "astro:assets";
import original from "../assets/mascots/snappy-original-1024.png";
import dino from "../assets/mascots/snappy-dino-kigurumi-1024.png";
import minion from "../assets/mascots/snappy-banana-goggle-minion-1024.png";
import werewolf from "../assets/mascots/snappy-werewolf-1024.png";

const MASCOTS = {
  original,
  "dino-kigurumi": dino,
  "banana-goggle-minion": minion,
  werewolf,
} as const;

// HSL hue per mascot. Drives the radial glow inside each polaroid
// frame so the color reads as belonging to that costume rather than
// being a generic accent. Hand-picked; if/when we scale to all 150+
// mascots we can swap to a build-time sharp.stats() extraction.
const TINTS: Record<keyof typeof MASCOTS, number> = {
  original: 30,            // orange — Snappy's natural color
  "dino-kigurumi": 140,    // leaf green
  "banana-goggle-minion": 50, // banana yellow
  werewolf: 270,           // unused: silhouette card uses its own night gradient
};

interface CastEntry {
  id: keyof typeof MASCOTS;
  name: string;
  role: string;
  body: string;
  stamp: string;
  rot: number;
  silhouette?: boolean;
}

const CAST: CastEntry[] = [
  // Top row (4)
  { id: "original",             name: "Snappy",       role: "Origin story",   body: "Snappy. Just Snappy.",                                          stamp: "OG",     rot: -3 },
  { id: "dino-kigurumi",        name: "Dino Snap",    role: "Jurassic issue", body: "Snappy gone prehistoric. Life, uh, finds a way to launch.",   stamp: "RAWR",   rot: -2 },
  { id: "original",             name: "Snappy",       role: "Origin story",   body: "Snappy. Just Snappy.",                                          stamp: "OG",     rot: 4 },
  { id: "original",             name: "Snappy",       role: "Origin story",   body: "Snappy. Just Snappy.",                                          stamp: "OG",     rot: -5 },
  // Bottom row (3)
  { id: "banana-goggle-minion", name: "Bananappy",    role: "Peel & launch",  body: "Snappy armed with a banana. LAUNCH! BA-NA-NA!",                stamp: "BANANA", rot: -4 },
  { id: "original",             name: "Snappy",       role: "Origin story",   body: "Snappy. Just Snappy.",                                          stamp: "OG",     rot: 2 },
  { id: "werewolf",             name: "Snappy the …?", role: "Lunar edition", body: "Something hairy this way comes.",                              stamp: "???",    rot: 5,  silhouette: true },
];

const TOP_ROW = CAST.slice(0, 4);
const BOTTOM_ROW = CAST.slice(4);
---

<section
  id="cast"
  class="relative overflow-hidden border-t border-border-divider px-6 pt-20 pb-24 lg:px-16 lg:pt-28 lg:pb-32"
>
  {/* Accent radial glows in opposite corners. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
    style="background:
      radial-gradient(ellipse 900px 500px at 15% 0%, color-mix(in srgb, var(--color-accent) 14%, transparent), transparent 60%),
      radial-gradient(ellipse 800px 500px at 85% 100%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 60%);"
  ></div>

  {/* Section head */}
  <div class="mb-12 text-center lg:mb-20">
    <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-accent">
      Meet the cast
    </p>
    <h2 class="text-balance text-4xl font-semibold leading-[1.1] tracking-tight md:text-5xl lg:text-[64px]">
      Snappy refuses to wear<br />
      <span class="font-medium italic text-accent">the same thing twice.</span>
    </h2>
    <p class="mx-auto mt-6 max-w-[680px] text-pretty text-base leading-relaxed text-text-secondary md:text-lg">
      150-plus costumes in the closet. Snappy picks a different one
      every time you summon the launcher, saves the bunny for Easter,
      the witch for Halloween, and something with claws for the full
      moon. Snappy is, frankly, a little weird about cosplay. The good
      kind of weird. We've stopped trying to talk Snappy out of it.
    </p>
  </div>

  {/* Top row — 4 polaroids */}
  <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">
    {TOP_ROW.map((c) => (
      <article
        class="group relative mx-auto w-full max-w-[320px] transition-[rotate,scale] duration-200 ease-out hover:rotate-0 hover:scale-[1.03] sm:mx-0 sm:max-w-none sm:rotate-[var(--rot)]"
        style={`--rot: ${c.rot}deg;`}
      >
{/* Portrait */}
        <div
          class:list={[
            "mb-4 flex aspect-square items-center justify-center overflow-hidden rounded-2xl border border-dashed sm:aspect-auto sm:h-44",
            c.silhouette
              ? "border-text-muted/30 bg-transparent dark:border-white/15 dark:bg-[linear-gradient(180deg,oklch(0.25_0.07_265)_0%,oklch(0.18_0.08_265)_100%)]"
              : "border-accent/35",
          ]}
          style={c.silhouette
            ? undefined
            : `background: radial-gradient(circle at 50% 60%, hsl(${TINTS[c.id]} 80% 60% / 0.32), transparent 70%), var(--color-surface-inset);`}
        >
          {c.silhouette && (
            <span
              aria-hidden="true"
              class="absolute mt-[-110px] ml-[120px] h-5 w-5 rounded-full bg-yellow-100/85 shadow-[0_0_18px_rgb(255_255_220/0.55)]"
            ></span>
          )}
          <Image
            src={MASCOTS[c.id]}
            alt=""
            width={180}
            height={180}
            densities={[1, 2, 3]}
            format="webp"
            class:list={[
              "max-h-[92%] max-w-[92%] object-contain drop-shadow-[0_6px_12px_rgb(0_0_0/0.18)]",
              c.silhouette && "opacity-50 [filter:brightness(0)]",
            ]}
          />
        </div>

        <div class="mb-1.5 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-accent">
          {c.role}
        </div>
        <h3 class="text-xl font-semibold leading-tight tracking-tight">{c.name}</h3>
        <p class="mt-2.5 text-pretty text-sm leading-[1.5] text-text-secondary">
          {c.body}
        </p>
      </article>
    ))}
  </div>

  {/* Bottom row — 3 polaroids, slightly narrower so they don't read as a
      truncated 4-up. */}
  <div class="mx-auto mt-10 grid max-w-[1100px] grid-cols-1 gap-10 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-12">
    {BOTTOM_ROW.map((c) => (
      <article
        class="group relative mx-auto w-full max-w-[320px] transition-[rotate,scale] duration-200 ease-out hover:rotate-0 hover:scale-[1.03] sm:mx-0 sm:max-w-none sm:rotate-[var(--rot)]"
        style={`--rot: ${c.rot}deg;`}
      >
<div
          class:list={[
            "relative mb-4 flex aspect-square items-center justify-center overflow-hidden rounded-2xl border border-dashed sm:aspect-auto sm:h-44",
            c.silhouette
              ? "border-text-muted/30 bg-transparent dark:border-white/15 dark:bg-[linear-gradient(180deg,oklch(0.25_0.07_265)_0%,oklch(0.18_0.08_265)_100%)]"
              : "border-accent/35",
          ]}
          style={c.silhouette
            ? undefined
            : `background: radial-gradient(circle at 50% 60%, hsl(${TINTS[c.id]} 80% 60% / 0.32), transparent 70%), var(--color-surface-inset);`}
        >
          {c.silhouette && (
            <span
              aria-hidden="true"
              class="absolute top-4 right-5 h-5 w-5 rounded-full bg-yellow-100/85 shadow-[0_0_18px_rgb(255_255_220/0.55)]"
            ></span>
          )}
          <Image
            src={MASCOTS[c.id]}
            alt=""
            width={180}
            height={180}
            densities={[1, 2, 3]}
            format="webp"
            class:list={[
              "max-h-[92%] max-w-[92%] object-contain drop-shadow-[0_6px_12px_rgb(0_0_0/0.18)]",
              c.silhouette && "opacity-50 [filter:brightness(0)]",
            ]}
          />
        </div>

        <div class="mb-1.5 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-accent">
          {c.role}
        </div>
        <h3 class="text-xl font-semibold leading-tight tracking-tight">{c.name}</h3>
        <p class="mt-2.5 text-pretty text-sm leading-[1.5] text-text-secondary">
          {c.body}
        </p>
      </article>
    ))}
  </div>
</section>
