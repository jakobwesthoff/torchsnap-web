---
// Tilted screenshot of the launcher with the relevant Gadget
// active. The asset is expected to be a transparent-trimmed
// PNG (run via `bun run trim:image …`) so it sits flush
// against its bounding box.
//
// The drop shadow uses CSS `drop-shadow` rather than
// `box-shadow` so it follows the trimmed silhouette of the
// launcher. A `box-shadow` would render a phantom rectangle
// in the empty headroom above the mascot perched on top of
// the search bar.

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  tilt: "left" | "right";
  image: { light: ImageMetadata; dark: ImageMetadata };
  alt: string;
}

const { tilt, image, alt } = Astro.props;

// Slight, deliberate tilt. Direction flips per row so the eye
// keeps moving down the page instead of locking onto a single
// diagonal. Magnitudes stay small (≈3°) — anything larger
// reads as a stylistic flourish rather than a casual snapshot.
const tiltClass = tilt === "left" ? "-rotate-[3deg]" : "rotate-[3deg]";
---

<div class="relative isolate">
  {/* Accent halo behind the screenshot. The gradient is
      anchored to the upper third of the bounding box rather
      than its geometric centre because the launcher chrome
      (search bar + mascot perched on top) lives in the top
      portion of every capture; the captures vary in height
      below that, but the visual centre of mass is consistent
      across all of them up there. Three explicit stops —
      bright at the anchor, a mid-falloff to keep the glow
      warm a little wider, then fully transparent at 70 % of
      the ellipse so the gradient fades cleanly to nothing
      well inside its bounding box. Sits in its own stacking
      context so the tilt of the screenshot doesn't drag the
      halo along with it. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -inset-12 -z-10"
    style="background: radial-gradient(ellipse 65% 50% at 50% 40%,
      color-mix(in srgb, var(--color-accent) 10%, transparent) 0%,
      color-mix(in srgb, var(--color-accent) 5%, transparent) 35%,
      transparent 70%);"
  ></div>

  <div
    data-tilt-target
    class:list={[
      "relative mx-auto w-full max-w-[520px]",
      "drop-shadow-[0_2px_8px_rgb(0_0_0/0.10)] drop-shadow-[0_18px_40px_rgb(0_0_0/0.16)]",
      "transition-transform duration-300 ease-out",
      "hover:rotate-0",
      tiltClass,
    ]}
  >
    <Image
      src={image.light}
      alt={alt}
      densities={[1, 2]}
      format="webp"
      loading="lazy"
      class="block h-auto w-full select-none dark:hidden"
    />
    <Image
      src={image.dark}
      alt={alt}
      densities={[1, 2]}
      format="webp"
      loading="lazy"
      class="hidden h-auto w-full select-none dark:block"
    />
  </div>
</div>
