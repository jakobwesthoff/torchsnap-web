---
// "Gadgets" section.
//
// Composition only — the four moving parts (rows, bundled
// blurb, ecosystem pillars) live in their own files. The
// order here is also the visual reading order:
//
//   1. Section head — eyebrow + two-line hed + sub-paragraph
//   2. Three alternating rows of featured Gadgets
//   3. Bundled Gadgets — the rest of what ships in the box
//   4. Ecosystem pillars — the open-ecosystem closer

import GadgetRow from "./GadgetRow.astro";
import BundledGadgets from "./BundledGadgets.astro";
import EcosystemPillars from "./EcosystemPillars.astro";
import { FEATURED } from "./gadgets";
---

<section id="gadgets" class="relative overflow-hidden border-t border-border-divider bg-surface">
  {/* Wide, faint accent glow behind the section head. Mirrors
      the MascotTheater treatment so #gadgets reads as the next
      named act on the page. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[480px]"
    style="background:
      radial-gradient(ellipse 900px 360px at 50% 0%, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 70%);"
  ></div>

  <div class="section-inner pt-14 pb-24 lg:pb-32">
    {/* Section head */}
    <div class="mb-16 text-center lg:mb-24">
      <p class="eyebrow mb-3">Open the drawer</p>
      <h2 class="text-balance text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl lg:text-[56px]">
        Snappy's gadgets.
        <br />
        <span class="font-medium italic text-accent">Every one of them a plugin.</span>
      </h2>
      <p class="mx-auto mt-5 max-w-[640px] text-pretty text-base leading-relaxed text-text-secondary md:text-lg">
        Pressing the hotkey reveals more than an app launcher. The emoji your sentence is missing,
        the math you'd have opened a tab for, the search that lands already on the answer page. None
        of it breaks the thing you were doing.
      </p>
    </div>

    {/* Featured trio. Rows alternate sides via the `index`
        prop; the row component itself is responsible for the
        side-flip and the mobile collapse.

        Mobile gets the largest gap of the three breakpoints:
        each row collapses to a centred screenshot+copy stack,
        and a generous separator is the only thing keeping
        adjacent Gadgets from running into each other visually. */}
    <div class="flex flex-col gap-32 md:gap-28 lg:gap-40">
      {FEATURED.map((gadget, i) => (
        <GadgetRow gadget={gadget} index={i + 1} />
      ))}
    </div>

    {/* Bundled Gadgets — quieter beat than the trio, separated
        by a generous gap. */}
    <div class="mt-24 lg:mt-32">
      <BundledGadgets />
    </div>

    {/* Ecosystem pillars — the open-ecosystem closer. */}
    <div class="mt-16 lg:mt-24">
      <EcosystemPillars />
    </div>
  </div>
</section>
